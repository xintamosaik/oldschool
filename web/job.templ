package web

import (
	"log"
	"net/http"
	"strconv"
	"templeruins/core"
	"templeruins/persistence/files"
)

var job = core.JobRead("0")

func handleEditJob(w http.ResponseWriter, r *http.Request) {
	id := r.PathValue("id")
	log.Println(id)
	EditJob(core.JobRead(id)).Render(r.Context(), w)
}

templ EditJob(old files.Job) {
	<form hx-post="/cv/update/job" hx-target="form" hx-swap="outerHTML">
		<input type="hidden" name="ID" value={ old.ID }/>
		<p>
			<label { "for" }="Company">
				Company
				<br/>
				<input type="text" name="Company" id="Company" value={ old.Company }/>
			</label>
		</p>
		<p>
			<label { "for" }="Location">
				Location
				<br/>
				<input type="text" name="Location" id="Location" value={ old.Location }/>
			</label>
		</p>
		<p>
			<label { "for" }="Role">
				Role
				<br/>
				<input type="text" name="Role" id="Role" value={ old.Role }/>
			</label>
		</p>
		<p>
			<label { "for" }="StartYear">
				StartYear
				<br/>
				<input type="number" min="1900" max="9999" name="StartYear" id="StartYear" value={ old.StartYear }/>
			</label>
		</p>
		<p>
			<label { "for" }="StartMonth">
				StartMonth
				<br/>
				<input type="number" min="1" max="12" name="StartMonth" id="StartMonth" value={ old.StartMonth }/>
			</label>
		</p>
		<p>
			<label { "for" }="IsCurrent">
				IsCurrent
				<br/>
				if old.IsCurrent {
					<label { "for" }="current">Yes</label>
					<input type="radio" name="IsCurrent" id="current" value="true" onClick="window.formjobend.hidden = true" checked/>
					<label { "for" }="old">No</label>
					<input type="radio" name="IsCurrent" id="old" value="false" onClick="window.formjobend.hidden = false"/>
				} else {
					<label { "for" }="current">Yes</label>
					<input type="radio" name="IsCurrent" id="current" value="true" onClick="window.formjobend.hidden = true"/>
					<label { "for" }="old">No</label>
					<input type="radio" name="IsCurrent" id="old" value="false" onClick="window.formjobend.hidden = false" checked/>
				}
			</label>
		</p>
		if old.IsCurrent {
			<div id="formjobend" hidden>
				<p>
					<label { "for" }="EndYear">
						EndYear
						<br/>
						<input type="number" min="1900" max="9999" name="EndYear" id="EndYear" value=""/>
					</label>
				</p>
				<p>
					<label { "for" }="EndMonth">
						EndMonth
						<br/>
						<input type="number" min="1" max="12" name="EndMonth" id="EndMonth" value=""/>
					</label>
				</p>
			</div>
		} else {
			<div id="formjobend">
				<p>
					<label { "for" }="EndYear">
						EndYear
						<br/>
						<input type="number" min="1900" max="9999" name="EndYear" id="EndYear" value={ *old.EndYear }/>
					</label>
				</p>
				<p>
					<label { "for" }="EndMonth">
						EndMonth
						<br/>
						<input type="number" min="1" max="12" name="EndMonth" id="EndMonth" value={ *old.EndMonth }/>
					</label>
				</p>
			</div>
		}
		<p>
			<label { "for" }="Highlights">
				highlights
				<br/>
				<textarea cols="80" rows="7" name="Highlights" id="Highlights">
					for _, item := range old.Highlights {
						{ item }
					}
				</textarea>
			</label>
		</p>
		<button type="submit">Submit</button>
	</form>
}

func handleUpdateJob(w http.ResponseWriter, r *http.Request) {

	isCurrent := r.FormValue("isCurrent") == "true"

	job := files.Job{
		ID:        r.FormValue("ID"),
		Company:   r.FormValue("subject"),
		Location:  r.FormValue("message"),
		Role:      r.FormValue("Role"),
		IsCurrent: isCurrent,
	}

	core.JobUpdate(job)

	Job(job).Render(r.Context(), w)
}

func init() {
	http.HandleFunc("/cv/edit/{id}/job", handleEditJob)
	http.HandleFunc("/cv/update/job", handleUpdateJob)
}

// formatEndDate safely checks if the end date is null (current job) or formats it
func formatEndDate(job files.Job) string {
	if job.IsCurrent || job.EndMonth == nil || job.EndYear == nil {
		return "Now"
	}
	// Dereference the pointers safely using *
	return strconv.Itoa(*job.EndMonth) + "/" + strconv.Itoa(*job.EndYear)
}

templ Job(job files.Job) {
	<div class="job entry" hx-post={ "/cv/edit/" + job.ID + "/job" } hx-trigger="click" hx-swap="outerHTML">
		<h3>
			<span>{ job.Role }</span>
			<span class="dash"></span>
			<span>{ job.Company }</span>
		</h3>
		<h4>
			<span>{ strconv.Itoa(job.StartMonth) }/{ strconv.Itoa(job.StartYear) }</span> - 
			<span>{ formatEndDate(job) }</span>
			<span class="dash"></span>
			<span>{ job.Location }</span>
		</h4>
		<ul>
			for _, item := range job.Highlights {
				<li>
					@templ.Raw(strongify(item))
				</li>
			}
		</ul>
	</div>
}
