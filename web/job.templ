package web

import (
	"log"
	"net/http"
	"strconv"
	"templeruins/core"
	"templeruins/persistence/files"
)

var job = core.JobRead("0")

func handleEditJob(w http.ResponseWriter, r *http.Request) {
	id := r.PathValue("id")
	log.Println(id)
	EditJob(core.JobRead(id)).Render(r.Context(), w)
}

templ company(company string) {
	<label { "for" }="Company">
		Company
		<br/>
		<input type="text" name="Company" id="Company" value={ company }/>
	</label>
}

templ location(location string) {
	<label { "for" }="Location">
		Location
		<br/>
		<input type="text" name="Location" id="Location" value={ location }/>
	</label>
}

templ role(role string) {
	<label { "for" }="Role">
		Role
		<br/>
		<input type="text" name="Role" id="Role" value={ role }/>
	</label>
}

templ startYear(startYear int) {
	<label { "for" }="StartYear">
		StartYear
		<br/>
		<input type="number" min="1900" max="9999" name="StartYear" id="StartYear" value={ startYear }/>
	</label>
}

templ startMonth(startMonth int) {
	<label { "for" }="StartMonth">
		StartMonth
		<br/>
		<input type="number" min="1" max="12" name="StartMonth" id="StartMonth" value={ startMonth }/>
	</label>
}

templ isCurrent(isCurrent bool) {
	<label { "for" }="IsCurrent">
		IsCurrent
		<br/>
		<label { "for" }="current">Yes</label>
		<input
			type="radio"
			name="IsCurrent"
			id="current"
			value="true"
			onClick="window.formjobend.hidden = true"
			if isCurrent {
				checked
			}
		/>
		<label { "for" }="old">No</label>
		<input
			type="radio"
			name="IsCurrent"
			id="old"
			value="false"
			onClick="window.formjobend.hidden = false"
			if isCurrent == false {
				checked
			}
		/>
	</label>
}

templ endYear(endYear int) {
	<label { "for" }="EndYear">
		EndYear
		<br/>
		<input type="number" min="1900" max="9999" name="EndYear" id="EndYear" value={ endYear }/>
	</label>
}

templ endMonth(endMonth int) {
	<label { "for" }="EndYear">
		EndYear
		<br/>
		<input type="number" min="1" max="12" name="EndMonth" id="EndMonth" value={ endMonth }/>
	</label>
}

templ highlights(highlights []string) {
	<label { "for" }="Highlights">
		Highlights
		<br/>
		<textarea cols="80" rows="7" name="Highlights" id="Highlights">
			for _, item := range highlights {
				+ { item }
			}
		</textarea>
	</label>
}

templ EditJob(old files.Job) {
	<form id={ "job-" + old.ID } hx-post="/cv/update/job" hx-target="form" hx-swap={ "#job-" + old.ID }>
		<input type="hidden" name="ID" value={ old.ID }/>
		<div>
			@company(old.Company)
		</div>
		<br/>
		<div>
			@location(old.Location)
		</div>
		<br/>
		<div>
			@role(old.Role)
		</div>
		<br/>
		<div>
			@startYear(old.StartYear)
		</div>
		<br/>
		<div>
			@startMonth(old.StartMonth)
		</div>
		<br/>
		<div>
			@isCurrent(old.IsCurrent)
		</div>
		<br/>
		<div
			id="formjobend"
			if old.IsCurrent {
				hidden
			}
		>
			<div>
				@endYear(old.EndYear)
			</div>
			<br/>
			<div>
				@endMonth(old.EndMonth)
			</div>
		</div>
		<br/>
		<div>
			@highlights(old.Highlights)
		</div>
		<br/>
		<button type="submit">Submit</button>
	</form>
}

func handleUpdateJob(w http.ResponseWriter, r *http.Request) {
	// 1. Parse standard primitive fields
	id := r.FormValue("ID")
	company := r.FormValue("Company")   // Swapped out "subject" for descriptive naming
	location := r.FormValue("Location") // Swapped out "message"
	role := r.FormValue("Role")
	isCurrent := r.FormValue("isCurrent") == "true"
	startYear, _ := strconv.Atoi(r.FormValue("startYear"))
	startMonth, _ := strconv.Atoi(r.FormValue("startMonth"))
	endYear, _ := strconv.Atoi(r.FormValue("startYear"))
	endMonth, _ := strconv.Atoi(r.FormValue("startMonth"))
	log.Println(r.FormValue("Highlights"))
	highlights := []string{r.FormValue("Highlights")}

	// 3. Construct your clean domain block
	job := files.Job{
		ID:         id,
		Company:    company,
		Location:   location,
		Role:       role,
		IsCurrent:  isCurrent,
		StartYear:  startYear,
		StartMonth: startMonth,
		EndYear:    endYear,
		EndMonth:   endMonth,
		Highlights: highlights,
	}

	// 4. Update and stream the component update back to HTMX
	core.JobUpdate(job)
	Job(job).Render(r.Context(), w)
}

func init() {
	http.HandleFunc("/cv/edit/{id}/job", handleEditJob)
	http.HandleFunc("/cv/update/job", handleUpdateJob)
}

templ Job(job files.Job) {
	<div class="job entry" hx-post={ "/cv/edit/" + job.ID + "/job" } hx-trigger="click" hx-swap="outerHTML">
		<h3>
			<span>{ job.Role }</span>
			<span class="dash"></span>
			<span>{ job.Company }</span>
		</h3>
		<h4>
			<span>{ strconv.Itoa(job.StartMonth) }/{ strconv.Itoa(job.StartYear) }</span> - 
			<span>{ strconv.Itoa(job.EndMonth) }/{ strconv.Itoa(job.EndYear) }</span>
			<span class="dash"></span>
			<span>{ job.Location }</span>
		</h4>
		<ul>
			for _, item := range job.Highlights {
				<li>
					@templ.Raw(strongify(item))
				</li>
			}
		</ul>
	</div>
}
